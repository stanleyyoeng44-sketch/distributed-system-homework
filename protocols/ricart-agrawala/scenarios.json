{
  "scenarios": [
    {
      "id": "normal-contention",
      "name": "RA normal: simultaneous node-1 and node-3",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "concurrent": [
            {
              "node": "node-1",
              "method": "Application.Acquire",
              "values": {
                "holdMs": 2000
              }
            },
            {
              "node": "node-3",
              "method": "Application.Acquire",
              "values": {
                "holdMs": 2000
              }
            }
          ],
          "expect": "ok"
        },
        {
          "until": {
            "node": [
              "node-1",
              "node-3"
            ],
            "path": "completed",
            "op": "==",
            "value": 1
          },
          "timeout": 20000
        },
        {
          "check": {
            "atMostOne": {
              "path": "role",
              "value": "critical"
            }
          },
          "label": "No overlapping critical sections in reported history"
        }
      ]
    },
    {
      "id": "crash",
      "name": "RA crash: uninvolved peer blocks",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "fault": {
            "kind": "crash",
            "node": "node-2"
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Acquire",
            "values": {
              "holdMs": 200
            }
          },
          "expect": "ok"
        },
        {
          "wait": 4000
        },
        {
          "check": {
            "node": "node-1",
            "path": "role",
            "op": "==",
            "value": "waiting"
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "entries",
            "op": "==",
            "value": 0
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "missingAcks",
            "op": "includes",
            "value": "node-2"
          }
        },
        {
          "check": {
            "atMostOne": {
              "path": "role",
              "value": "critical"
            }
          },
          "label": "No overlapping critical sections in reported history"
        }
      ]
    },
    {
      "id": "partition",
      "name": "RA partition: no replay after healing",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "fault": {
            "kind": "link",
            "from": "node-1",
            "to": "node-3",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Acquire",
            "values": {
              "holdMs": 200
            }
          },
          "expect": "ok"
        },
        {
          "wait": 4000
        },
        {
          "check": {
            "node": "node-1",
            "path": "entries",
            "op": "==",
            "value": 0
          }
        },
        {
          "fault": {
            "kind": "heal"
          }
        },
        {
          "wait": 2000
        },
        {
          "check": {
            "node": "node-1",
            "path": "entries",
            "op": "==",
            "value": 0
          }
        },
        {
          "check": {
            "atMostOne": {
              "path": "role",
              "value": "critical"
            }
          },
          "label": "No overlapping critical sections in reported history"
        }
      ]
    },
    {
      "id": "jitter-fifo",
      "name": "RA random load: exponential FIFO",
      "settings": {
        "nodeCount": 5,
        "latency": 80,
        "delayModel": "exponential",
        "jitter": 80
      },
      "steps": [
        {
          "concurrent": [
            {
              "node": "node-1",
              "method": "Application.Auto",
              "values": {
                "count": 2
              }
            },
            {
              "node": "node-2",
              "method": "Application.Auto",
              "values": {
                "count": 2
              }
            },
            {
              "node": "node-3",
              "method": "Application.Auto",
              "values": {
                "count": 2
              }
            },
            {
              "node": "node-4",
              "method": "Application.Auto",
              "values": {
                "count": 2
              }
            },
            {
              "node": "node-5",
              "method": "Application.Auto",
              "values": {
                "count": 2
              }
            }
          ],
          "expect": "ok"
        },
        {
          "until": {
            "node": "*",
            "path": "completed",
            "op": "==",
            "value": 2
          },
          "timeout": 60000
        },
        {
          "check": {
            "atMostOne": {
              "path": "role",
              "value": "critical"
            }
          },
          "label": "No overlapping critical sections in reported history"
        }
      ]
    },
    {
      "id": "jitter-unordered",
      "name": "RA random load: unordered messages",
      "settings": {
        "nodeCount": 5,
        "latency": 20,
        "delayModel": "fixed",
        "jitter": 0,
        "network": {
          "ordering": "unordered",
          "reorderRate": 1,
          "reorderMin": 0,
          "reorderMax": 500
        }
      },
      "steps": [
        {
          "concurrent": [
            {
              "node": "node-1",
              "method": "Application.Auto",
              "values": {
                "count": 10
              }
            },
            {
              "node": "node-2",
              "method": "Application.Auto",
              "values": {
                "count": 10
              }
            },
            {
              "node": "node-3",
              "method": "Application.Auto",
              "values": {
                "count": 10
              }
            },
            {
              "node": "node-4",
              "method": "Application.Auto",
              "values": {
                "count": 10
              }
            },
            {
              "node": "node-5",
              "method": "Application.Auto",
              "values": {
                "count": 10
              }
            }
          ],
          "expect": "ok"
        },
        {
          "until": {
            "node": "*",
            "path": "completed",
            "op": "==",
            "value": 10
          },
          "timeout": 120000
        },
        {
          "check": {
            "atMostOne": {
              "path": "role",
              "value": "critical"
            }
          },
          "label": "No overlapping critical sections in reported history"
        }
      ]
    },
    {
      "id": "long-hold-timeout",
      "name": "RA limitation: deferred permission exceeds SDK deadline",
      "settings": { "nodeCount": 3, "latency": 30 },
      "steps": [
        { "input": { "node": "node-1", "method": "Application.Acquire", "values": { "holdMs": 12000 } }, "expect": "ok" },
        { "until": { "node": "node-1", "path": "role", "op": "==", "value": "critical" }, "timeout": 5000 },
        { "input": { "node": "node-2", "method": "Application.Acquire", "values": { "holdMs": 100 } }, "expect": "ok" },
        { "until": { "node": "node-2", "path": "sendErrors", "op": ">=", "value": 1 }, "timeout": 15000 },
        { "until": { "node": "node-1", "path": "completed", "op": "==", "value": 1 }, "timeout": 10000 },
        { "wait": 1000 },
        { "check": { "all": [
          { "node": "node-2", "path": "role", "op": "==", "value": "waiting" },
          { "node": "node-2", "path": "entries", "op": "==", "value": 0 },
          { "node": "node-2", "path": "missingAcks", "op": "includes", "value": "node-1" },
          { "node": "node-2", "path": "lastError", "op": "includes", "value": "deadline" }
        ] }, "label": "SDK deadline and a late reply never grant permission" },
        { "check": { "atMostOne": { "path": "role", "value": "critical" } }, "label": "No overlapping critical sections" }
      ]
    },
    {
      "id": "variant-message-count",
      "name": "RA design: four messages, no Release",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "input": {
            "node": "node-1",
            "method": "Application.Acquire",
            "values": {
              "holdMs": 200
            }
          },
          "expect": "ok"
        },
        {
          "until": {
            "node": "node-1",
            "path": "completed",
            "op": "==",
            "value": 1
          },
          "timeout": 20000
        },
        {
          "check": {
            "messages": {
              "method": "MutexService.Request",
              "op": "==",
              "value": 2
            }
          }
        },
        {
          "check": {
            "messages": {
              "method": "MutexService.Ack",
              "op": "==",
              "value": 0
            }
          }
        },
        {
          "check": {
            "messages": {
              "method": "MutexService.Release",
              "op": "==",
              "value": 0
            }
          }
        },
        {
          "check": {
            "all": [
              { "node": "node-1", "path": "messagesSent", "op": "==", "value": 2 },
              { "node": "node-2", "path": "messagesSent", "op": "==", "value": 1 },
              { "node": "node-3", "path": "messagesSent", "op": "==", "value": 1 }
            ]
          },
          "label": "Two requests plus two permission responses; no separate Ack calls"
        },
        {
          "check": {
            "atMostOne": {
              "path": "role",
              "value": "critical"
            }
          },
          "label": "No overlapping critical sections in reported history"
        }
      ]
    }
  ]
}
